# TC Work Zone Locator - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# OFFLINE MODE
# ===========================================
# Set to 'true' to force offline mode (bypass external APIs)
OFFLINE_MODE=false

# ===========================================
# MAP & LOCATION APIS (Optional)
# ===========================================
# These are optional - the app works without them using free alternatives

# Google Maps Geocoding API (for speed verification)
GOOGLE_MAPS_API_KEY=

# TomTom API (alternative geocoding)
TOMTOM_API_KEY=

# HERE Maps API (alternative geocoding)
HERE_API_KEY=

# Mapbox API (alternative mapping)
MAPBOX_ACCESS_TOKEN=

# ===========================================
# CACHE SETTINGS
# ===========================================
# Amenities cache duration in milliseconds (default: 5 minutes)
AMENITIES_CACHE_DURATION_MS=300000

# ===========================================
# NOTES
# ===========================================
# - All variables are optional
# - The app uses Open-Meteo for weather (free, no API key needed)
# - The app uses OSRM for routing (free, no API key needed)
# - The app uses Overpass for POIs (free, no API key needed)
# - API keys above are only needed for speed limit verification features
