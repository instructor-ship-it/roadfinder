  "complianceNotes": [
    {
      "note": "All high risk work must be performed by licensed operators",
      "reference": "Regulation 81",
      "title": "Licence required to carry out high risk work",
      "documentPage": 107,
      "physicalPage": 145,
      "consequence": "Penalties up to $30,000 for individuals and $150,000 for body corporates"
    },
    {
      "note": "Confined space entry requires written authority specifying hazard controls",
      "reference": "Regulation 67",
      "title": "Confined space entry permit",
      "documentPage": 91,
      "physicalPage": 129,
      "consequence": "Prohibition notices and prosecution for unauthorized entry"
    },
    {
      "note": "Workers must use PPE in accordance with training and instructions provided",
      "reference": "Regulation 46",
      "title": "Duties of worker",
      "documentPage": 64,
      "physicalPage": 102,
      "consequence": "Fine up to $4,200 for individuals who fail to use or intentionally misuse PPE",
      "employeeDuty": true
    },
    {
      "note": "Workers must not intentionally misuse or damage PPE and must report damage or defects",
      "reference": "Regulation 46",
      "title": "Duties of worker",
      "documentPage": 64,
      "physicalPage": 102,
      "consequence": "Fine up to $4,200 for individuals",
      "employeeDuty": true
    },
    {
      "note": "Workers have the right to information, training and instruction about workplace hazards and control measures",
      "reference": "Regulation 39",
      "title": "Provision of information, training and instruction",
      "documentPage": 55,
      "physicalPage": 93,
      "consequence": "Employer fines up to $7,000 for individuals or $35,000 for body corporates",
      "employeeRight": true
    },
    {
      "note": "Health and safety representatives are entitled to 5 days initial training plus annual refresher training",
      "reference": "Regulation 21",
      "title": "Training for health and safety representatives",
      "documentPage": 48,
      "physicalPage": 86,
      "consequence": "Employer must approve and facilitate training",
      "employeeRight": true
    },
    {
      "note": "Audiometric testing must be provided within 3 months of starting noisy work and every 2 years thereafter",
      "reference": "Regulation 58",
      "title": "Audiometric testing",
      "documentPage": 82,
      "physicalPage": 120,
      "consequence": "Employer fines up to $7,000 for individuals or $35,000 for body corporates",
      "employeeRight": true
    },
    {
      "note": "Workers can request issue resolution and must be provided with a written agreement if requested",
      "reference": "Regulation 23",
      "title": "Default procedure",
      "documentPage": 49,
      "physicalPage": 87,
      "consequence": "Employer must facilitate resolution process",
      "employeeRight": true
    },
    {
      "note": "Commercial vehicle drivers must not exceed 168 hours work time in any 14-day period",
      "reference": "Regulation 184E",
      "title": "Commercial vehicle driver: hours of work",
      "documentPage": 208,
      "physicalPage": 246,
      "consequence": "Fine up to $7,000 for individuals",
      "employeeDuty": true
    },
    {
      "note": "Workers must not work in roof spaces unless electrical installation is de-energised",
      "reference": "Regulation 153",
      "title": "Work in roof spaces",
      "documentPage": 183,
      "physicalPage": 221,
      "consequence": "Fine up to $7,000 for individuals; serious injury or death risk",
      "employeeDuty": true
    },
    {
      "note": "Lead risk workers are entitled to health monitoring before starting work and at regular intervals",
