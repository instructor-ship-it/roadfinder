  "keyRequirements": [
    {
      "requirement": "All traffic management plans must be prepared by accredited personnel and submitted for approval prior to commencing works",
      "section": "Section 4.2",
      "priority": "critical"
    },
    {
      "requirement": "Traffic controllers must hold current Main Roads WA accreditation",
      "section": "Section 8.2",
      "priority": "critical"
    },
    {
      "requirement": "Temporary speed zones must be established in accordance with approved criteria and signage requirements",
      "section": "Section 6.5",
      "priority": "high"
    },
    {
      "requirement": "Truck Mounted Attenuators (TMAs) must be deployed for mobile and stationary works on high-speed roads as specified",
      "section": "Section 6.9",
      "priority": "high"
    },
    {
      "requirement": "Portable Traffic Control Devices (PTCDs) must be used on State Roads as the preferred method of traffic control",
      "section": "Section 6.8.3",
      "priority": "high"
    },
    {
      "requirement": "Sign spacing must comply with specified tolerances based on speed zones",
      "section": "Section 6.1.9",
      "priority": "high"
    },
    {
      "requirement": "All personnel working on roads must complete appropriate accreditation training",
      "section": "Section 8",
      "priority": "critical"
    }
  ],
  "complianceNotes": [
    {
      "note": "Failure to obtain TMP approval before commencing works constitutes a breach of the Code",
      "reference": "Section 4.2.1",
      "consequence": "Work stoppage, potential prosecution under Road Traffic Code 2000"
    },
    {
      "note": "Operation of traffic control activities without valid accreditation is a statutory offence",
      "reference": "Section 8.1",
      "consequence": "Fines up to $50,000 for individuals under WHS legislation"
    },
    {
      "note": "Non-compliance with TMA requirements on designated roads is a breach of Code requirements",
      "reference": "Section 6.9.1",
      "consequence": "Safety incident liability, potential prosecution"
    },
    {
      "note": "All works affecting traffic signal operation require prior consultation with Main Roads",
      "reference": "Section 2.3",
      "consequence": "Works may be halted, coordination failures"
    }
  ],
